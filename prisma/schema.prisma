generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  email          String    @unique
  passwordHash   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  answerRecords    AnswerRecord[]
  favorites        Favorite[]
  jobApplications  JobApplication[]
  interviewRecords InterviewRecord[]
  mockInterviews   MockInterview[]

  @@map("users")
}

enum QuestionStatus {
  none
  completed
  review
}

model AnswerRecord {
  id          String         @id @default(uuid())
  userId      String
  questionId  String
  status      QuestionStatus @default(none)
  note        String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("answer_records")
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  questionId  String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("favorites")
}

enum JobStatus {
  applied
  interviewing
  offered
  rejected
}

model JobApplication {
  id           String    @id @default(uuid())
  userId       String
  companyName  String
  position     String
  status       JobStatus @default(applied)
  salary       String    @default("")
  location     String    @default("")
  jobUrl       String    @default("")
  notes        String    @default("")
  appliedDate  String
  lastUpdated  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewRecords InterviewRecord[]

  @@map("job_applications")
}

enum InterviewResult {
  pending
  passed
  failed
  cancelled
}

model InterviewRecord {
  id           String          @id @default(uuid())
  userId       String
  jobId        String
  companyName  String
  position     String
  round        String
  date         String
  time         String
  result       InterviewResult @default(pending)
  notes        String          @default("")
  interviewer  String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  JobApplication? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("interview_records")
}

enum InterviewType {
  technical
  hr
  behavioral
}

model MockInterview {
  id              String        @id @default(uuid())
  userId          String
  type            InterviewType
  typeLabel       String
  startTime       DateTime
  endTime         DateTime
  duration        Int
  overallScore    Int
  maxScore        Int
  questionCount   Int
  summary         String
  suggestions     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mock_interviews")
}
